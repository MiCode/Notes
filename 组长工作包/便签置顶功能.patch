+
+    private void setSelectedNotesPinned(boolean pinned) {
+        HashSet<Long> ids = mNotesListAdapter.getSelectedItemIds();
+        if (ids == null || ids.isEmpty()) {
+            return;
+        }
+
+        StringBuilder selection = new StringBuilder(NoteColumns.ID).append(" IN (");
+        String[] selectionArgs = new String[ids.size()];
+        int index = 0;
+        for (Long id : ids) {
+            if (index > 0) {
+                selection.append(",");
+            }
+            selection.append("?");
+            selectionArgs[index] = String.valueOf(id);
+            index++;
+        }
+        selection.append(")");
+
+        ContentValues values = new ContentValues();
+        values.put(NoteColumns.PINNED, pinned ? 1 : 0);
+        int updated = mContentResolver.update(Notes.CONTENT_NOTE_URI, values,
+                selection.toString(), selectionArgs);
+        if (updated > 0) {
+            Toast.makeText(this, pinned ? R.string.pinned_success : R.string.unpinned_success,
+                    Toast.LENGTH_SHORT).show();
+        }
+        mModeCallBack.finishActionMode();
+        startAsyncNotesListQuery();
     }
 
